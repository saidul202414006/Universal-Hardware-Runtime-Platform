# Universal Hardware Runtime Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# =============================================================================
# Core Runtime
# =============================================================================

# API Key for authenticating requests (generate a strong random key)
# If not set, a random key will be generated and printed on startup
UHR_API_KEY=

# Server host and port
UHR_HOST=0.0.0.0
UHR_PORT=8765

# Log level: TRACE | DEBUG | INFO | WARNING | ERROR | CRITICAL
UHR_LOG_LEVEL=INFO

# Log format: json | console
UHR_LOG_FORMAT=json

# Runtime environment: development | production
UHR_ENV=development

# =============================================================================
# Database
# =============================================================================

# SQLite (default) — no changes needed
UHR_DATABASE_URL=sqlite+aiosqlite:///./data/runtime.db

# PostgreSQL (optional, for multi-user server mode)
# UHR_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/uhr_db

# =============================================================================
# Security
# =============================================================================

# Rate limit: requests per minute per client
UHR_RATE_LIMIT_PER_MINUTE=120

# Allowed CORS origins (comma-separated)
UHR_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# Tool Paths (leave empty for auto-detection from PATH)
# =============================================================================
UHR_ESPTOOL_PATH=
UHR_ARDUINO_CLI_PATH=
UHR_AVRDUDE_PATH=
UHR_OPENOCD_PATH=
UHR_PICOTOOL_PATH=

# =============================================================================
# MCP Server
# =============================================================================
UHR_MCP_TRANSPORT=stdio
UHR_MCP_ENABLED=true
